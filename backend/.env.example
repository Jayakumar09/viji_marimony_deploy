CLOUDINARY_CLOUD_NAME=do6o1xqs1
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Admin Credentials
ADMIN_EMAIL=info@vijayalakshmiboyarmatrimony.com
ADMIN_PHONE=+917639150271

# Payment Gateway (Razorpay/Stripe)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# PhonePe Payment Gateway Configuration
# Get these from https://business.phonepe.com/
PHONEPE_ENVIRONMENT=sandbox
PHONEPE_MERCHANT_ID=PGTESTPAYUAT86
PHONEPE_MERCHANT_KEY=96434309-7796-489d-8924-ab56988a6076

# Exchange Rate API (for international payments)
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest
EXCHANGE_RATE_API_KEY=your-exchange-rate-api-key

# Payment Settings
PAYMENT_COMMISSION_PERCENTAGE=4
INTERNATIONAL_PAYMENTS_ENABLED=true

# Bank Account Details (for direct bank transfer payments)
# IMPORTANT: Replace these with your actual bank details in .env (never commit real details)
BANK_ACCOUNT_HOLDER_NAME=Account Holder Name
BANK_NAME=Your Bank Name
BANK_ACCOUNT_NUMBER=XXXXXXXXXXX
BANK_IFSC_CODE=XXXX0000000
BANK_BRANCH=Branch Name
BANK_PIN_CODE=000000

# Encryption Key for ID Numbers (AES-256)
# Generate a secure random string (at least 32 characters)
ENCRYPTION_KEY=your-secure-encryption-key-min-32-chars

# ===========================================
# AI VERIFICATION CONFIGURATION
# ===========================================

# AWS Configuration for Rekognition (Face Matching)
# Get these from https://console.aws.amazon.com/iam
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-south-1
AWS_REKOGNITION_COLLECTION_ID=boyar-matrimony-faces

# AWS S3 Bucket for temporary image storage (optional, for large files)
AWS_S3_BUCKET=your-s3-bucket-name

# AI Verification Settings
AI_VERIFICATION_ENABLED=true
AI_CONFIDENCE_THRESHOLD=0.85
AI_FACE_MATCH_THRESHOLD=0.90
AI_TAMPER_THRESHOLD=0.30

# Rate Limiting for AI endpoints (requests per minute)
AI_RATE_LIMIT=10

# Tesseract OCR Language (for Indian documents)
TESSERACT_LANGUAGE=eng+hin

# ===========================================
# DATABASE BACKUP SETTINGS
# ===========================================
# Set to 'true' to use Google Drive for backups (default: true in production)
USE_GOOGLE_DRIVE=true
# Set to 'true' to also store backups locally (default: false)
USE_LOCAL_BACKUP=false
# Local folder path for backups (optional)
BACKUP_LOCAL_PATH=./backups
# Retention period in days (keep last N backups)
BACKUP_RETENTION_DAYS=7
# Cron schedule for daily backup (default: 2:00 AM IST)
BACKUP_CRON_HOUR=2
BACKUP_CRON_MINUTE=0

# ===========================================
# GOOGLE DRIVE API (OAuth 2.0 for User Account)
# ===========================================
# IMPORTANT: Service Accounts do NOT have storage quota!
# Use OAuth 2.0 with a real user account instead.

# Steps to get credentials:
# 1. Go to https://console.cloud.google.com/
# 2. Create OAuth 2.0 Client ID (Web application type)
# 3. Add authorized redirect URI: https://developers.google.com/oauthplayground
# 4. Enable Google Drive API in the API Library
# 5. Go to https://developers.google.com/oauthplayground
# 6. Click Settings > Use your own OAuth credentials
# 7. Enter your Client ID and Client Secret
# 8. In Step 1, select "Drive API v3" with scope https://www.googleapis.com/auth/drive
# 9. Click "Authorize APIs" and complete the OAuth flow
# 10. In Step 2, click "Exchange authorization code for tokens"
# 11. Copy the refresh_token

# OAuth Client ID from Google Cloud Console
GOOGLE_DRIVE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# OAuth Client Secret from Google Cloud Console  
GOOGLE_DRIVE_CLIENT_SECRET=your-client-secret

# Refresh Token (obtained via OAuth Playground)
GOOGLE_DRIVE_REFRESH_TOKEN=your-refresh-token
